# MetalSense Environment Configuration (Placeholders only)

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB connection string; fallback to in-memory store if unset in test)
MONGODB_URI=mongodb://localhost:27017/metalsense

# Authentication & Session
SESSION_SECRET=metalsense_dev_session_secret_change_in_production_32chars
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# AI & Document Extraction
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=20000

# File Uploads
UPLOAD_MAX_BYTES=10485760
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# Maps
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
